# STAR website — Apache config for OCF (and any Apache static host).
#
# This is a single-page app: only index.html + assets exist on disk. Client-side
# routes like /projects or /leads have no matching file, so we route every
# request that isn't a real file/dir back to index.html and let React Router
# render the right page. Without this, deep links and refreshes 404.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Served at the domain root. If this site lives under a subpath
  # (e.g. /~star/), change this to "RewriteBase /~star/" and rebuild with a
  # matching Vite `base` + Router `basename`.
  RewriteBase /

  # Real files and directories are served as-is (assets, images, etc.).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback if mod_rewrite is unavailable: unknown paths still boot the app.
ErrorDocument 404 /index.html

# ── Compression ─────────────────────────────────────────────────────────────
# OCF doesn't gzip by default; the JS bundle ships ~3x smaller compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────────
# Vite fingerprints /assets/*.js|css with a content hash, so they can be cached
# forever. Images (fixed names) get a week. HTML is always revalidated so new
# deploys are picked up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
