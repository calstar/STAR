#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════
# flight_test: the flight computer's gate. Run it before every commit to
# firmware/Flight_Computer. Modeled on daq-server/test/test_integration.sh.
#
#   1  build & static   firmware builds clean, fits, is formatted, DMA
#                       buffers are where DMA can reach them
#   2  unit suites      radio (PlatformIO), self-test, eMMC log, chip
#                       drivers, task cores; ASan/UBSan
#   3  end to end       flight_e2e: a scripted flight through the REAL
#                       drivers, cores and eMMC log on fake chips/card
#   4  canary           a deliberately broken e2e build must FAIL
#   5  board (--board)  flash over ST-Link, read the on-board self-test back
#                       over SWD, one check per chip
#
# Usage:
#   ./flight_test                     stages 1-4 (what CI runs)
#   ./flight_test --board             also stage 5 (board + ST-Link attached)
#   ./flight_test --only=conservation,gps   or by number: --only=1,12
#   ./flight_test --list              every check id and what it proves
#   ./flight_test -v                  print the log of each failed check
# Exit status: 0 only if every selected check passed.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
OUT="$HERE/.pio/flight_test"
PIO="${PIO:-$(command -v pio || echo "$HOME/.platformio/penv/bin/pio")}"
TOOLS="$HOME/.platformio/packages/toolchain-gccarmnoneeabi/bin"
NM="$TOOLS/arm-none-eabi-nm"
GDB="$TOOLS/arm-none-eabi-gdb"
OPENOCD_DIR="$HOME/.platformio/packages/tool-openocd"
ELF="$HERE/.pio/build/flight/firmware.elf"

VERBOSE=0 BOARD=0 LIST=0 ONLY=""
for arg in "$@"; do
  case "$arg" in
    -v|--verbose) VERBOSE=1 ;;
    --board) BOARD=1 ;;
    --list) LIST=1 ;;
    --only=*) ONLY="${arg#--only=}" ;;
    -h|--help) sed -n '2,25p' "$0"; exit 0 ;;
    *) echo "unknown argument: $arg (see --help)"; exit 2 ;;
  esac
done
mkdir -p "$OUT"

# ── check registry ─────────────────────────────────────────────────────────
NUM=0 PASSED=() FAILED=()
now() { perl -MTime::HiRes=time -e 'printf "%.2f", time'; }

selected() { # id number
  [ -z "$ONLY" ] && return 0
  local item
  for item in ${ONLY//,/ }; do
    [ "$item" = "$1" ] || [ "$item" = "$2" ] && return 0
  done
  return 1
}

record() { # id description status detail seconds
  local line="$1: $2"
  [ -n "$4" ] && line="$line ($4)"
  if [ "$3" = PASS ]; then
    printf '  ✅ %2d %-18s %s  [%ss]\n' "$NUM" "$1" "$2" "$5"
    PASSED+=("$line")
  else
    printf '  ❌ %2d %-18s %s  [%ss]\n' "$NUM" "$1" "$2" "$5"
    [ -n "$4" ] && printf '        %s\n' "$4"
    FAILED+=("$line")
    if [ "$VERBOSE" = 1 ] && [ -s "$OUT/$1.log" ]; then
      tail -40 "$OUT/$1.log" | sed 's/^/        | /'
    fi
  fi
}

# check id "description" command...   (PASS = command exits 0)
check() {
  local id="$1" what="$2"; shift 2
  NUM=$((NUM + 1))
  if [ "$LIST" = 1 ]; then printf '%2d  %-18s %s\n' "$NUM" "$id" "$what"; return; fi
  selected "$id" "$NUM" || return 0
  local t0 t1 status=PASS detail=""
  t0=$(now)
  if ! "$@" >"$OUT/$id.log" 2>&1; then
    status=FAIL
    detail="$(grep -E -m1 'error|FAIL|Error|failed|:[0-9]+: ' "$OUT/$id.log" | cut -c1-160)"
  fi
  t1=$(now)
  record "$id" "$what" "$status" "$detail" "$(echo "$t1 - $t0" | bc)"
}

stage() { [ "$LIST" = 1 ] && echo "── $1" || printf '\n── %s\n' "$1"; }

ctest_suite() { # name source_dir [sanitizer option, default SELF_TEST_SANITIZERS]
  local build="$OUT/build_$1"
  cmake -S "$HERE/$2" -B "$build" -D"${3:-SELF_TEST_SANITIZERS}"=ON >/dev/null &&
    cmake --build "$build" -j 4 &&
    ctest --test-dir "$build" --output-on-failure
}

# ── stage 1: build & static ────────────────────────────────────────────────
build_clean() {
  # Only CubeMX's own known warning is allowed; any other warning fails.
  "$PIO" run -d "$HERE" -e flight || return 1
  "$PIO" run -d "$HERE" -e flight -t clean >/dev/null
  "$PIO" run -d "$HERE" -e flight 2>&1 | tee "$OUT/build_output.txt" >/dev/null
  if grep -E 'warning:' "$OUT/build_output.txt" | grep -v 'HAL_RCC_USB_OTG_HS_CLK_ENABLED'; then
    echo "FAIL: new compiler warnings"; return 1
  fi
}

size_budget() {
  local out flash dtcm d1
  rm -f "$ELF" # force a re-link: the linker prints memory usage only then
  out="$("$PIO" run -d "$HERE" -e flight 2>&1)" || return 1
  echo "$out" | grep -E 'FLASH:|DTCMRAM:|RAM_D1:'
  flash=$(echo "$out" | awk '/FLASH:/{gsub("%","",$NF); print int($NF)}')
  dtcm=$(echo "$out" | awk '/DTCMRAM:/{gsub("%","",$NF); print int($NF)}')
  d1=$(echo "$out" | awk '/RAM_D1:/{gsub("%","",$NF); print int($NF)}')
  [ "${flash:-100}" -lt 50 ] || { echo "FAIL: flash ${flash}% >= 50%"; return 1; }
  [ "${dtcm:-100}" -lt 70 ] || { echo "FAIL: DTCM ${dtcm}% >= 70%"; return 1; }
  [ "${d1:-0}" -gt 0 ] || { echo "FAIL: nothing in RAM_D1 (eMMC DMA buffers missing)"; return 1; }
}

format_clean() {
  local files
  # Every hand-written file: src/ and tests/. Core/, Drivers/ and
  # Middlewares/ are CubeMX's and are left as CubeMX writes them.
  files=$(cd "$HERE" && ls src/*/*.[ch] src/*/*.cpp tests/*/*.[ch] tests/*/*.cpp \
            tests/radio/*/*.cpp tests/radio/*/*.h 2>/dev/null)
  (cd "$HERE" && clang-format --dry-run --Werror $files)
}

dma_placement() {
  # Every symbol in .dma_buffers must lie in AXI SRAM (RAM_D1), which the
  # SDMMC IDMA and DMA1/2 can reach; DTCM is CPU-only (RM0468 p.106-108).
  local bad=0 n=0 addr name
  while read -r addr _ _ name; do
    n=$((n + 1))
    a=$((16#$addr))
    if [ $a -lt $((16#24000000)) ] || [ $a -ge $((16#24050000)) ]; then
      echo "FAIL: $name at 0x$addr is outside RAM_D1"; bad=1
    else
      echo "ok: $name at 0x$addr"
    fi
  done < <("$TOOLS/arm-none-eabi-objdump" -t "$ELF" | awk '$4==".dma_buffers" && $NF!=".dma_buffers"{print $1, $2, $3, $NF}')
  [ $n -gt 0 ] || { echo "FAIL: no DMA buffers found"; return 1; }
  return $bad
}

stage "1  build & static"
check build "firmware builds for the STM32H723 with no new warnings" build_clean
check size "flash < 50 %, DTCM < 70 %, eMMC DMA buffers in RAM_D1" size_budget
check format "hand-written C/C++ is clang-formatted" format_clean
check dma_placement "every DMA buffer links into RAM_D1 (0x24000000-0x2404FFFF)" dma_placement

# ── stage 2: unit suites ───────────────────────────────────────────────────
stage "2  unit suites (ASan/UBSan)"
check radio "radio: frames, ARM gate, SX1262 receive + start-up + TxDone (PlatformIO native)" \
  "$PIO" test -d "$HERE" -e native
check self_test "self-test coordinator + device protocols, GNSS frames, SD SPI" \
  ctest_suite self_test tests/self_test
check emmc "eMMC log: chunks, mount, torn writes, card checks, flight state" \
  ctest_suite emmc tests/emmc
check chips "chip drivers vs datasheets: ISM330DHCX, H3LIS100DL, MS5611, UBX" \
  ctest_suite chips tests/chips
check app "task cores: sensors, GNSS, boot report, sleep math, mode" ctest_suite app tests/app
check idle "Idle logic (Aaron, PR #162): heartbeat schedule, battery, Arm" \
  ctest_suite idle tests/idle IDLE_SANITIZERS

check health_radio "health task, watchdog check-ins, sleep lease, SelfTest send" \
  ctest_suite health_radio tests/health_radio

# ── stage 3: end to end ────────────────────────────────────────────────────
stage "3  end to end: flight (drivers -> cores -> eMMC) and Idle (heartbeats, Stop, Arm)"
E2E_BUILD="$OUT/build_e2e"
E2E_READY=0
if [ "$LIST" = 1 ] || cmake -S "$HERE/tests/e2e" -B "$E2E_BUILD" -DSELF_TEST_SANITIZERS=ON >"$OUT/e2e_build.log" 2>&1 &&
   cmake --build "$E2E_BUILD" -j 4 >>"$OUT/e2e_build.log" 2>&1; then
  E2E_READY=1
fi
# flight_e2e: the flight (sensors, GPS, eMMC); idle_e2e: Idle (heartbeats,
# Stop, Arm over LoRa). Same CHECK line protocol.
E2E_BINS="flight_e2e idle_e2e"
if [ "$LIST" = 1 ]; then
  cmake -S "$HERE/tests/e2e" -B "$E2E_BUILD" >/dev/null 2>&1 &&
    cmake --build "$E2E_BUILD" >/dev/null 2>&1
  for bin in $E2E_BINS; do
    while IFS=$'\t' read -r id what; do
      NUM=$((NUM + 1)); printf '%2d  %-18s %s\n' "$NUM" "$id" "$what"
    done < <("$E2E_BUILD/$bin" --list)
  done
elif [ "$E2E_READY" = 1 ]; then
  for bin in $E2E_BINS; do
    while IFS=$'\t' read -r id what; do
      NUM=$((NUM + 1))
      selected "$id" "$NUM" || continue
      t0=$(now)
      line="$("$E2E_BUILD/$bin" --only="$id" 2>"$OUT/$id.log" | grep '^CHECK ')"
      t1=$(now)
      status=$(echo "$line" | awk '{print $3}')
      detail="${line#*| }"
      echo "$line" >>"$OUT/$id.log"
      record "$id" "$what" "${status:-FAIL}" "$detail" "$(echo "$t1 - $t0" | bc)"
    done < <("$E2E_BUILD/$bin" --list)
  done
else
  NUM=$((NUM + 1))
  record e2e_build "end-to-end harness builds" FAIL "see $OUT/e2e_build.log" 0
fi

# ── stage 4: the tests can fail ────────────────────────────────────────────
canary() {
  local build="$OUT/build_canary"
  cmake -S "$HERE/tests/e2e" -B "$build" -DFLIGHT_TEST_CANARY=ON >/dev/null &&
    cmake --build "$build" -j 4 >/dev/null || { echo "FAIL: canary did not build"; return 1; }
  local out; out="$("$build/flight_e2e" --only=conservation,emmc_roundtrip)"
  echo "$out"
  if echo "$out" | grep -q '^CHECK conservation FAIL' &&
     echo "$out" | grep -q '^CHECK emmc_roundtrip FAIL'; then
    echo "ok: one flipped byte on the card is caught"
  else
    echo "FAIL: corrupting the card went unnoticed: the checks cannot fail"; return 1
  fi
}
stage "4  test of the tests"
check canary "one corrupted byte on the card makes conservation + roundtrip FAIL" canary

# ── stage 5: on the board ──────────────────────────────────────────────────
board_report() {
  # Flash, reset, wait for the bring-up self-test, then read g_bringup_report
  # over SWD (OpenOCD + gdb, batch mode).
  local ocd="$OPENOCD_DIR/bin/openocd" scripts="$OPENOCD_DIR/openocd/scripts"
  [ -x "$ocd" ] || ocd="$(command -v openocd)"
  [ -d "$scripts" ] || scripts="$OPENOCD_DIR/share/openocd/scripts"
  "$ocd" -s "$scripts" -f interface/stlink.cfg -f target/stm32h7x.cfg \
    -c "gdb_port 3333" -c "tcl_port disabled" -c "telnet_port disabled" \
    >"$OUT/openocd.log" 2>&1 &
  local ocd_pid=$!
  sleep 2
  cat >"$OUT/report.gdb" <<'GDB'
set pagination off
target extended-remote :3333
monitor reset halt
# DBGMCU_CR (0x5C001004, RM0468 p.3230): keep SWD alive in Sleep/Stop (D1)
# and Stop (D3), or the board vanishes from the debugger at its first sleep.
monitor mmw 0x5C001004 0x00000083 0
monitor resume
set $tries = 0
while $tries < 45
  shell sleep 1
  monitor halt
  if g_bringup_report.finished
    loop_break
  end
  monitor resume
  set $tries = $tries + 1
end
printf "FINISHED %d\n", g_bringup_report.finished
printf "APP %d\n", g_bringup_report.app_started
set $i = 0
while $i < g_bringup_report.self_test.device_count
  printf "DEV %d %d %d %d\n", g_bringup_report.self_test.devices[$i].device_id, g_bringup_report.self_test.devices[$i].reply.result, g_bringup_report.self_test.devices[$i].reply.diagnostic, g_bringup_report.self_test.devices[$i].attempts
  set $i = $i + 1
end
set $i = 0
while $i < 7
  printf "ADC %d %d %d\n", $i, g_bringup_report.analog.valid[$i], g_bringup_report.analog.counts[$i]
  set $i = $i + 1
end
printf "BATT %d %d %d\n", g_bringup_report.report.battery.state, g_bringup_report.report.battery.mv, g_bringup_report.report.battery.counts
printf "VERDICT %d\n", g_bringup_report.report.verdict
printf "REPORT_BEGIN\n"
printf "%s", &g_bringup_report.report.text[0]
printf "REPORT_END\n"
# FLASH_OPTSR_CUR (0x5200201C): bit 6 NRST_STOP_D1 (RM0468 p.208)
printf "OPTSR %u\n", *(unsigned int*)0x5200201C
# Idle: let it sleep through a few heartbeats, then read the counters.
monitor resume
shell sleep 35
monitor halt
printf "SLEEP %d %d %u %u %u %u\n", 'board_sleep.c'::info.ready, 'board_sleep.c'::info.stop_allowed, 'board_sleep.c'::info.lsi_hz, 'board_sleep.c'::info.sleeps, 'board_sleep.c'::info.rtc_wakes, 'board_sleep.c'::info.awake_waits
printf "IDLE %u %u %d\n", 'idle_task.c'::idle.last.sequence, 'idle_task.c'::idle.last.consecutive_send_failures, 'idle_task.c'::idle.last.previous_send
monitor resume
detach
GDB
  "$GDB" -batch -x "$OUT/report.gdb" "$ELF" >"$OUT/board_report.txt" 2>&1
  local rc=$?
  kill "$ocd_pid" 2>/dev/null; wait "$ocd_pid" 2>/dev/null
  grep -q '^FINISHED 1' "$OUT/board_report.txt" || { cat "$OUT/board_report.txt"; return 1; }
  return $rc
}

board_battery() {
  # battery_state_t (src/app/battery.h): 1 OK, 2 WARN, 3 FAIL, 4 USB, 5 INVALID
  local state mv
  read -r _ state mv _ < <(grep '^BATT ' "$OUT/board_report.txt")
  local v; v=$(printf '%d.%02d V' $((mv / 1000)) $((mv % 1000 / 10)))
  case "$state" in
    1) echo "battery $v OK" ;;
    4) echo "on USB ($v): battery not measured" ;;
    2) echo "FAIL battery $v: below 7.0 V, charge it"; return 1 ;;
    3) echo "FAIL battery $v: below 6.6 V or above 8.8 V"; return 1 ;;
    *) echo "FAIL battery not read (state $state)"; return 1 ;;
  esac
}

board_verdict() {
  # boot_verdict_t (src/app/boot_report.h): 0 READY, 1 WARN, 2 FAIL
  local v; v=$(awk '/^VERDICT /{print $2}' "$OUT/board_report.txt")
  sed -n '/^REPORT_BEGIN/,/^REPORT_END/p' "$OUT/board_report.txt" | sed '1d;$d'
  case "$v" in
    0) echo "READY" ;;
    1) echo "FAIL board says WARN"; return 1 ;;
    *) echo "FAIL board says FAIL ($v)"; return 1 ;;
  esac
}

board_option_bytes() {
  local optsr; optsr=$(awk '/^OPTSR /{print $2}' "$OUT/board_report.txt")
  [ -n "$optsr" ] || { echo "FAIL option bytes not read"; return 1; }
  if (( (optsr >> 6) & 1 )); then
    echo "NRST_STOP_D1 = 1: Stop does not reset the chip"
  else
    echo "FAIL NRST_STOP_D1 = 0: Stop would reset the chip, so Idle waits awake."
    echo "Set it with STM32CubeProgrammer (option bytes, User Configuration)."
    return 1
  fi
}

board_lsi() {
  local ready lsi; read -r _ ready _ lsi _ < <(grep '^SLEEP ' "$OUT/board_report.txt")
  echo "LSI measured at ${lsi:-?} Hz (32 kHz nominal)"
  [ "$ready" = 1 ] && [ "${lsi:-0}" -ge 28800 ] && [ "${lsi:-0}" -le 35200 ]
}

board_idle() {
  local sleeps wakes waits seq fails prev
  read -r _ _ _ _ sleeps wakes waits < <(grep '^SLEEP ' "$OUT/board_report.txt")
  read -r _ seq fails prev < <(grep '^IDLE ' "$OUT/board_report.txt")
  echo "35 s of Idle: ${seq:-?} heartbeats, ${sleeps:-?} Stop sleeps, ${wakes:-?} RTC wakes, ${waits:-?} refused, ${fails:-?} failed sends"
  [ "${seq:-0}" -ge 3 ] && [ "${sleeps:-0}" -ge 3 ] && [ "${wakes:-0}" -ge 3 ] &&
    [ "${fails:-1}" = 0 ] || { echo "FAIL Idle did not sleep and send as expected"; return 1; }
}

board_device() { # device_id
  local line; line=$(grep "^DEV $1 " "$OUT/board_report.txt")
  echo "$line"
  # result 1 = PASS (self_test_port.h)
  [ "$(echo "$line" | awk '{print $3}')" = 1 ]
}

if [ "$BOARD" = 1 ] || [ "$LIST" = 1 ]; then
  stage "5  on the board (ST-Link)"
  check board_flash "build and flash over ST-Link" "$PIO" run -d "$HERE" -e flight -t upload
  check board_selftest "board ran its self-test; report read back over SWD" board_report
  names=(imu highg baro ethernet radio gnss nand emmc)
  whats=("ISM330DHCX answers (WHO_AM_I 0x6B)" "H3LIS100DL answers (WHO_AM_I 0x32)"
         "MS5611 PROM + CRC4 valid" "W5500 VERSIONR 0x04" "SX1262 status/errors clean"
         "MAX-M10S sends a valid NMEA/UBX frame" "SD NAND init + CID CRC" "eMMC identified, CID read")
  for i in 0 1 2 3 4 5 6 7; do
    check "board_${names[$i]}" "${whats[$i]}" board_device "$i"
  done
  check board_battery "battery read through SW_ST + PA0: >= 7.0 V, or on USB" board_battery
  check board_verdict "the board's own verdict is READY (LED2 off)" board_verdict
  check board_app "application tasks started after the self-test" \
    grep -q '^APP 1' "$OUT/board_report.txt"
  check board_option_bytes "NRST_STOP_D1 = 1: Stop sleeps, not resets" board_option_bytes
  check board_lsi "RTC's LSI measured within 10 % of 32 kHz" board_lsi
  check board_idle "35 s of Idle: >= 3 heartbeats sent (TxDone), Stop + RTC wakes" board_idle
  if [ "$LIST" = 0 ] && [ -s "$OUT/board_report.txt" ]; then
    printf '\n  The board reports:\n'
    sed -n '/^REPORT_BEGIN/,/^REPORT_END/p' "$OUT/board_report.txt" | sed '1d;$d' | sed 's/^/    /'
  fi
fi

[ "$LIST" = 1 ] && exit 0

# ── summary ────────────────────────────────────────────────────────────────
printf '\n%s\n' "════════════════════════════════════════════════════════════"
printf '  Results: %d passed, %d failed\n' "${#PASSED[@]}" "${#FAILED[@]}"
printf '%s\n' "════════════════════════════════════════════════════════════"
if [ ${#FAILED[@]} -gt 0 ]; then
  printf '\n  Failed:\n'; printf '    ❌ %s\n' "${FAILED[@]}"
fi
if [ ${#PASSED[@]} -gt 0 ]; then
  printf '\n  Passed:\n'; printf '    ✅ %s\n' "${PASSED[@]}"
fi
printf '\n  Logs: %s\n' "$OUT"
[ ${#FAILED[@]} -eq 0 ]
