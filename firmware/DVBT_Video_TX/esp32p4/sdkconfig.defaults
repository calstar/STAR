CONFIG_IDF_TARGET="esp32p4"
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Camera + H.264 (third_party/, tools/fetch-video-deps.sh)
CONFIG_SPIRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_ENABLE_HW_H264_VIDEO_DEVICE=y
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1920X1080_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n
# HDMI input through a TC358743 bridge (Geekworm C790 / Waveshare HDMI-to-CSI,
# Pi 15-pin camera cable) -- e.g. the Hawkeye Firefly Split V5's micro-HDMI
# out at 1080p30. esp_video probes the SCCB bus and uses whichever of the
# TC358743 (0x0F) and the OV5647 (0x36) answers.
CONFIG_CAMERA_TC358743=y
CONFIG_CAMERA_TC358743_MIPI_YUV422_1920X1080_30FPS=y
CONFIG_CAMERA_TC358743_MIPI_DEFAULT_FMT_YUV422_1920X1080_30FPS=y
