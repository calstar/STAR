# Build context is the REPO ROOT, not EngineDesign/: the runtime image copies
# several EngineDesign/ subtrees plus lib/stardesign, and only a root context
# reaches both. The app implements no auth (Caddy is the gate), so nothing from
# auth/ is needed here. See the engine-design-api service in docker-compose.yml.
#
# There is no compiler stage any more. The accelerator is numba (engine/accel),
# which JITs from the Python sources copied below -- so the image needs no
# cmake, no build-essential, and no prebuilt .so. The C port this replaced lived
# at EngineDesign/engine/native and is deleted; the COPY of that directory is
# what broke this build on main.

# ── The runtime image ──────────────────────────────────────────────────────
FROM python:3.12-slim
WORKDIR /app

# Set as environment, not as `pip install --retries ... --timeout ...` flags.
# Some dependencies here (simplekml, via rocketpy) ship only an sdist, so pip
# builds them in an isolated environment -- and it installs that environment's
# build deps by spawning a *fresh pip subprocess* which inherits none of the
# parent's command-line flags. That subprocess was falling back to the stock
# 15s timeout and dying on a slow setuptools download. Env vars reach it.
ENV PIP_RETRIES=10 \
    PIP_TIMEOUT=120 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

# requirements-base.txt, not requirements.txt: the latter adds rocketcea, which
# has no wheel (a 69 MB Fortran sdist) and needs gfortran to compile -- neither
# of which this image has any use for. rocketcea is imported lazily and only to
# *build* a CEA cache; the API reads the committed tables copied in below.
# Same reasoning as CI. See requirements-base.txt.
COPY EngineDesign/requirements-base.txt .

# The cache mount matters more than retries: pip retries connections, not a
# download that breaks mid-stream, so without it every failed attempt at a large
# package starts again from zero. Both layers share the mount.
#
# setuptools and wheel go in first so the sdist builds below find them already
# present and cached, rather than each fetching its own copy over the network.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-base.txt

# Backend source
# The shared design core: per-user storage, sharing, and version history. Copied
# before the app so a change to the app alone reuses this layer.
COPY lib/stardesign/ /stardesign/
RUN --mount=type=cache,target=/root/.cache/pip pip install /stardesign

COPY EngineDesign/backend/ ./backend/
COPY EngineDesign/engine/  ./engine/
COPY EngineDesign/copv/    ./copv/
COPY EngineDesign/configs/ ./configs/

# Flight simulation: engine/optimizer/copv_flight_helpers.py imports
# ui.flight_sim lazily. Without this the import raises ModuleNotFoundError,
# which its outer `except Exception` swallows into {"success": False,
# "error": "No module named 'ui'"} -- the feature breaks silently rather than
# loudly. Safe to copy now that the Streamlit files have left ui/.
COPY EngineDesign/ui/ ./ui/

# Committed CEA tables. Without these the engine pipeline would try to build a
# cache on first use and fail on the missing rocketcea -- the rest of
# output/ is generated data and stays out (see .dockerignore).
COPY EngineDesign/output/cache/ ./output/cache/

ENV PYTHONPATH=/app

# Assert the accelerator is usable, at build time, and warm it.
#
# The assert is the point. engine.accel degrades to pure Python on any import
# failure, so a numba missing from the image would never raise -- it would
# surface only as an optimizer crawling ~25-30x slower in production, which is
# exactly how the old C kernel used to fail. A failed build is the only place
# that stays visible.
#
# The warmup is a bonus: the kernels are @njit(cache=True), so compiling here
# bakes the on-disk cache into this layer and the first request in a fresh
# container does not pay the JIT cost. warmup() never raises by contract, so its
# return value is what gets checked.
RUN python -c "\
import sys, engine.accel as accel; \
sys.exit('[accel] FATAL: numba is not importable in this image -- the optimizer would silently fall back to pure Python. Check that numba installed from requirements-base.txt.') if not accel.available() else None; \
sys.exit('[accel] FATAL: numba imported but the kernels failed to compile. Run engine.accel.warmup() locally for the traceback.') if not accel.warmup() else None; \
print('[accel] numba kernels compiled and cached')"

EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
