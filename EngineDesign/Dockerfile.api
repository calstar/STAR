# Build context is the REPO ROOT, not EngineDesign/ -- a Dockerfile cannot COPY
# from outside its context, and this image needs auth/shared_auth.py. See the
# engine-design-api service in docker-compose.yml.
FROM python:3.12-slim
WORKDIR /app

# Install Python deps
COPY EngineDesign/requirements.txt .
# Retries/timeout: a single slow PyPI read should not fail a deploy build.
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r requirements.txt

# Shared JWT helper, imported by the backend's auth middleware
COPY auth/shared_auth.py /auth/shared_auth.py

# Backend source
COPY EngineDesign/backend/ ./backend/
COPY EngineDesign/engine/  ./engine/
COPY EngineDesign/copv/    ./copv/
COPY EngineDesign/configs/ ./configs/

ENV PYTHONPATH=/app:/auth
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
