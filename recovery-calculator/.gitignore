.venv/
__pycache__/
*.py[cod]

# Node deps, anywhere under the project. frontend/.gitignore already covers
# frontend/, but a stray root-level node_modules (e.g. from running `npx` at
# this level) must be ignored too so it cannot be committed by accident.
node_modules/

# Scraper scratch output (`--out-dir out`); the committed table lives in
# star_recovery/data/.
out/

# Export bundles from PLAN.md §11.4 — timestamped run directories.
recovery_*/

# Per-user data written when running without a mounted volume (dev): unit prefs
# (/api/settings) and named saved configs (/api/configs). USERDATA_DIR points
# elsewhere in prod; unset in dev this lands here. Never commit it.
.userdata/

# Legacy: the old global settings file, before units went per-user.
.gui-settings.json
.gui-settings-*.tmp
