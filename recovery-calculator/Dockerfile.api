# Recovery Calculator — API image.
#
# Build context is the REPO ROOT: the backend is built on lib/stardesign, the
# design core shared with EngineDesign and pid-designer. (It still implements no
# auth -- Caddy is the gate, see deploy/Caddyfile.) The .dockerignore keeps the
# context from ballooning.
FROM python:3.12-slim
WORKDIR /app

# Env, not CLI flags: pip installs an sdist's build dependencies in a fresh
# subprocess that inherits no command-line options, so --timeout/--retries there
# would silently fall back to the stock 15s. Env vars reach it.
ENV PIP_RETRIES=10 \
    PIP_TIMEOUT=120 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

COPY recovery-calculator/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

# The shared design core: per-user storage, sharing, and version history. Copied
# before the app so a change to the app alone reuses this layer.
COPY lib/stardesign/ /stardesign/
RUN --mount=type=cache,target=/root/.cache/pip pip install /stardesign

# The web app is one consumer of the `physics` package; backend/main.py puts the
# subproject root (/app) on sys.path so `import physics` resolves. physics/ also
# carries data/parachutes.csv, loaded once at startup.
COPY recovery-calculator/physics/ ./physics/
COPY recovery-calculator/backend/ ./backend/

ENV PYTHONPATH=/app
EXPOSE 8100
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8100"]
