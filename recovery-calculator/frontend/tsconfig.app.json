{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Shared design-tool UI, compiled from source by this app's own Vite -- so
       the three apps need not agree on a Vite version. The matching runtime
       alias (and the React pin the shared source needs, because it sits outside
       this project and cannot resolve our node_modules) is in vite.config.ts. */
    "baseUrl": ".",
    "paths": {
      "@stardesign-ui": ["../../lib/stardesign-ui/src/index.ts"],
      "@stardesign-ui/*": ["../../lib/stardesign-ui/src/*"],
      /* The shared source is outside this project, so neither tsc nor Vite can
         resolve React by walking up from it. Both are pointed at our copy --
         which also guarantees one React instance rather than two. */
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"]
    },
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "../../lib/stardesign-ui/src"]
}
