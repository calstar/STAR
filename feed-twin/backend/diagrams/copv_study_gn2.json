      "data": {
        "componentType": "KBOTTLE",
        "label": "COPV-GN2",
        "fluid": "nitrogen",
        "params": {
          "pressure": {
            "value": 4500,
            "unit": "psi",
            "source": "manufacturer",
            "reference": "service pressure"
          },
          "temperature": {
            "value": 293.15,
            "unit": "K",
            "source": "measured",
            "reference": ""
          },
          "volume": {
            "value": 4.6871,
            "unit": "L",
            "source": "measured",
            "reference": "45 scf SCBA cylinder: 52.8 mol std air, Z=1.115 at 4500 psi -> 4.64 L water volume, plus 3 in^3 of fittings (estimated)"
          },
          "wall_mass": {
            "value": 3.5,
            "unit": "kg",
            "source": "estimated",
            "reference": "45 scf SCBA cylinder: aluminium liner with carbon overwrap, ~3.5 kg bare. Weigh it"
          },
          "wall_capacity": {
            "value": 850,
            "unit": "J/(kg.K)",
            "source": "estimated",
            "reference": "aluminium liner (900) and carbon overwrap (~800), mass-weighted"
          },
          "wall_conductance": {
            "value": 20,
            "unit": "W/K",
            "source": "estimated",
            "reference": "dense-gas natural convection over ~0.16 m^2 at 100-150 W/(m^2.K); the least-known number on the stand"
          },
          "MAWP": {
            "value": 6750,
            "unit": "psi",
            "source": "estimated",
            "reference": "1.5 x the 4500 psi service pressure of an SCBA-class COPV; the hydrotest figure. The twin trips and asks for a reset above this."
          }
        }
      }
    },
