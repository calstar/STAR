{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* pid-designer's canvas and the shared design-tool UI it imports, compiled
       from source by this app. The matching runtime aliases, and the pins to
       this app's own React and React Flow, are in vite.config.ts. */
    "baseUrl": ".",
    "paths": {
      "@pid/*": ["../../pid-designer/frontend/src/components/pid/*"],
      "@stardesign-ui": ["../../lib/stardesign-ui/src/index.ts"],
      "@stardesign-ui/*": ["../../lib/stardesign-ui/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@xyflow/react": ["./node_modules/@xyflow/react"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "../../lib/stardesign-ui/src"]
}
