# STAR Internal Tools — Caddyfile
#
# Auth lives here, once, for every app.
#
# Each protected site imports the (protected) snippet, which calls the auth
# service's /verify ahead of the request. Caddy forwards only on a 2xx and
# copies anything else straight back to the browser -- so /verify answering
# "302 to the login page" is what bounces an unauthenticated visitor, and
# "401" is what a fetch() or WebSocket gets instead. See auth/main.py.
#
# The apps themselves implement no auth, and dev never runs Caddy, which is why
# `./dev.sh` shows no login screen.
#
# ── TLS ──
#   Default:           Caddy obtains and renews Let's Encrypt certificates.
#   Cloudflare Tunnel: set SCHEME=http. Cloudflare terminates TLS at the edge
#                      and cloudflared speaks plain HTTP to Caddy, so Caddy
#                      binds :80 only and issues no certificates.
#
# ── Env ──
#   SCHEME        https (default) | http
#   BASE_DOMAIN   starberkeley.org
#   ACME_EMAIL    contact address for Let's Encrypt
#   DAQ_BACKEND   host:port of the DAQ Node backend  (API + WebSocket)
#   DAQ_GUI       host:port of the DAQ static SPA server
{
	email {$ACME_EMAIL:infra@starberkeley.org}
	# trusted_proxies is deliberately unset: Caddy then overwrites X-Forwarded-*
	# on every request rather than honouring what a client sent, which is what
	# lets /verify trust those headers when rebuilding the original URL.
}

# Gate a site on a valid session. Import this first in each site block.
(protected) {
	forward_auth {$AUTH_UPSTREAM:auth:5000} {
		uri /verify
		# Identity for the upstream app, taken from the /verify response.
		copy_headers X-Auth-Email X-Auth-User
		# A WebSocket handshake carries Connection: Upgrade + Upgrade: websocket.
		# gunicorn (the auth service) 400s on the /verify subrequest when both are
		# present, so Caddy denies the upgrade before it reaches the app — which is
		# why any protected app's WebSocket (e.g. daq-server) never connects. Strip
		# them from the auth subrequest ONLY; Caddy still proxies the real upgrade
		# to the app untouched.
		header_up -Connection
		header_up -Upgrade
	}
}

# ── Auth service ───────────────────────────────────────────────────────────
# Never gated -- it is what grants access, so protecting it would deadlock.
{$SCHEME:https}://auth.{$BASE_DOMAIN:starberkeley.org} {
	reverse_proxy {$AUTH_UPSTREAM:auth:5000}
}

# ── Landing page ───────────────────────────────────────────────────────────
# Protected like everything else: it is the index of internal tools, not a
# public site. Drop the import to make it the one public page.
{$SCHEME:https}://{$BASE_DOMAIN:starberkeley.org} {
	import protected
	reverse_proxy landing:4175
}

# ── Engine Design ──────────────────────────────────────────────────────────
{$SCHEME:https}://engine-design.{$BASE_DOMAIN:starberkeley.org} {
	import protected

	handle /api/* {
		reverse_proxy engine-design-api:8000
	}
	handle {
		reverse_proxy engine-design-frontend:4173
	}
}

