# STAR EC2 box stack — copy to .env and fill in. Never commit .env.
# auth secrets + STARProject + tunnel token (+ legacy OpenProject secret).

# ── auth ──────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=                 # token_hex(32); reused by the local-machine apps
FLASK_SECRET_KEY=           # token_hex(32)
AUTH_PUBLIC_URL=https://auth.starberkeley.org

# ── Caddy (STARProject gate) ────────────────────────────────────────────────
# Cloudflare terminates TLS, so Caddy speaks plain HTTP on :80 (no ACME).
SCHEME=http
BASE_DOMAIN=starberkeley.org

# ── STARProject (task tracker) ──────────────────────────────────────────────
# Its Postgres runs as the starproject-db service (DATABASE_URL is assembled in
# docker-compose.yml from the three vars below). SET A REAL PASSWORD in prod.
# The app runs `prisma migrate deploy` on startup — no manual migration step.
STARPROJECT_DB_USER=starproject
STARPROJECT_DB_PASSWORD=replace-with-a-strong-password
STARPROJECT_DB_NAME=starproject
STARPROJECT_APP_BASE_URL=https://project.starberkeley.org
# Shared secret for the nightly deadline/digest scans (app + starproject-cron):
STARPROJECT_CRON_SECRET=replace-with-a-random-string
# Email via SES: set a verified sender to enable outbound mail (else the app just
# logs). The EC2 instance IAM role supplies AWS creds, so no access keys here —
# just the region and the From identity.
# STARPROJECT_SES_FROM=STAR Project <noreply@starberkeley.org>
AWS_REGION=us-east-2

# ── OpenProject (LEGACY — retired, kept for rollback) ───────────────────────
OPENPROJECT_HOST__NAME=openproject.starberkeley.org
# REUSE the existing value from ~/openproject/docker-compose.yml — do NOT
# regenerate (it encrypts stored data + signs sessions).
OPENPROJECT_SECRET_KEY_BASE=

# ── Outbound email (Amazon SES) ───────────────────────────────────────────
# SMTP creds from SES console → SMTP settings → "Create SMTP credentials"
# (this makes an IAM user; the password is NOT your AWS secret key). Set the
# region in the address to wherever you verified the domain identity.
SES_SMTP_ADDRESS=email-smtp.us-east-2.amazonaws.com
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
# From address — its domain must be a verified SES identity (starberkeley.org).
OPENPROJECT_MAIL__FROM=openproject@starberkeley.org

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
