# STAR Internal Tools — Caddyfile
#
# Auth lives here, once, for every app.
#
# Each protected site imports the (protected) snippet, which calls the auth
# service's /verify ahead of the request. Caddy forwards only on a 2xx and
# copies anything else straight back to the browser -- so /verify answering
# "302 to the login page" is what bounces an unauthenticated visitor, and
# "401" is what a fetch() or WebSocket gets instead. See auth/main.py.
#
# The apps themselves implement no auth, and dev never runs Caddy, which is why
# `./dev.sh` shows no login screen.
#
# ── TLS ──
#   Default:           Caddy obtains and renews Let's Encrypt certificates.
#   Cloudflare Tunnel: set SCHEME=http. Cloudflare terminates TLS at the edge
#                      and cloudflared speaks plain HTTP to Caddy, so Caddy
#                      binds :80 only and issues no certificates.
#
# ── Env ──
#   SCHEME        https (default) | http
#   BASE_DOMAIN   starberkeley.org
#   ACME_EMAIL    contact address for Let's Encrypt
#   DAQ_BACKEND   host:port of the DAQ Node backend  (API + WebSocket)
#   DAQ_GUI       host:port of the DAQ static SPA server
{
	email {$ACME_EMAIL:infra@starberkeley.org}
	# trusted_proxies is deliberately unset: Caddy then overwrites X-Forwarded-*
	# on every request rather than honouring what a client sent, which is what
	# lets /verify trust those headers when rebuilding the original URL.
}

# Gate a site on a valid session. Import this first in each site block.
(protected) {
	# Strip any X-Auth-* the *client* sent before the app can see it. forward_auth
	# overwrites these from the /verify response on the happy path, so this is
	# belt-and-braces -- but the stakes changed when designs became shareable:
	# X-Auth-Email now decides which user's designs you may edit, not merely which
	# folder your own data lands in. Never let a client propose one.
	#
	# route {} is required, not cosmetic: the Caddyfile adapter otherwise re-sorts
	# by built-in directive order, placing request_header AFTER forward_auth — which
	# would delete the X-Auth-* headers forward_auth just set, handing the app a
	# request with no identity. Wrapping keeps the strip ahead of the gate.
	route {
		request_header -X-Auth-Email 
		request_header -X-Auth-User

		forward_auth {$AUTH_UPSTREAM:auth:5000} {
			uri /verify
			# Identity for the upstream app, taken from the /verify response.
			copy_headers X-Auth-Email X-Auth-User
			# A WebSocket handshake carries Connection: Upgrade + Upgrade: websocket.
			# gunicorn (the auth service) 400s on the /verify subrequest when both are
			# present, so Caddy denies the upgrade before it reaches the app — which is
			# why any protected app's WebSocket (e.g. daq-server) never connects. Strip
			# them from the auth subrequest ONLY; Caddy still proxies the real upgrade
			# to the app untouched.
			header_up -Connection
			header_up -Upgrade
		}
	}
}

# ── Auth service ───────────────────────────────────────────────────────────
# Never gated -- it is what grants access, so protecting it would deadlock.
{$SCHEME:https}://auth.{$BASE_DOMAIN:starberkeley.org} {
	reverse_proxy {$AUTH_UPSTREAM:auth:5000}
}

# ── Landing page ───────────────────────────────────────────────────────────
# Protected like everything else: it is the index of internal tools, not a
# public site. Drop the import to make it the one public page.
{$SCHEME:https}://{$BASE_DOMAIN:starberkeley.org} {
	import protected
	reverse_proxy landing:4175
}

# ── Engine Design ──────────────────────────────────────────────────────────
{$SCHEME:https}://engine-design.{$BASE_DOMAIN:starberkeley.org} {
	import protected

	handle /api/* {
		reverse_proxy engine-design-api:8000
	}
	handle {
		reverse_proxy engine-design-frontend:4173
	}
}

# ── P&ID Designer ──────────────────────────────────────────────────────────
{$SCHEME:https}://pid-designer.{$BASE_DOMAIN:starberkeley.org} {
	import protected

	handle /api/* {
		reverse_proxy pid-designer-api:8001
	}
	handle {
		reverse_proxy pid-designer-frontend:4174
	}
}

# ── STAR OpenRocket ───────────────────────────────────────────────────────────
# `import protected` is the same shared @berkeley.edu gate as everywhere else, so
# the whole app still requires a login. The tighter approved-users allowlist is
# enforced inside auth's /verify ONLY on the Onshape search/build paths (those
# spend the shared key pair) -- /verify reads the forwarded URI and answers 403
# for an unapproved user on just those calls, 200 everywhere else. Nothing extra
# is needed here. See auth/allowlist.py (_APP_PROTECTED_PATHS).
{$SCHEME:https}://openrocket.{$BASE_DOMAIN:starberkeley.org} {
	import protected

	handle /api/* {
		reverse_proxy star-openrocket-api:8002
	}
	handle {
		reverse_proxy star-openrocket-frontend:4177
	}
}

# ── DAQ Run Viewer ───────────────────────────────────────────────────────────
# Read-only viewer for past Elodin runs. Unlike the apps above it is a single
# container: FastAPI serves both /api and the built SPA, so one reverse_proxy
# covers everything (no /api split). See the daq-viewer service in
# docker-compose.yml. This is separate from the DAQ *server* below.
{$SCHEME:https}://daq-viewer.{$BASE_DOMAIN:starberkeley.org} {
	import protected
	reverse_proxy daq-viewer:8420
}

# STARProject (the team task tracker) moved to the EC2 box — see
# deploy/ec2/Caddyfile and deploy/ec2/docker-compose.yml. It is served at
# project.starberkeley.org from there, not this apps machine.

# ── DAQ Server ─────────────────────────────────────────────────────────────
# Not containerised. The C++ bridge, elodin-db and the Node backend run
# natively on the test-stand machine (daq-server/deploy/systemd), because they
# need the hardware. One backend process serves both listeners:
#   :8081  REST API + WebSocket
#   :3000  the built SPA (frontend/dist)
# The SPA detects it was served on a default port and switches to same-origin
# /api and /ws, which is what these routes expect.
{$SCHEME:https}://daq-server.{$BASE_DOMAIN:starberkeley.org} {
	import protected

	handle /api/* {
		reverse_proxy {$DAQ_BACKEND:host.docker.internal:8081}
	}
	# Caddy proxies the upgrade transparently; the backend's WebSocketServer is
	# bound to the whole HTTP server, so the /ws path needs no rewrite.
	handle /ws* {
		reverse_proxy {$DAQ_BACKEND:host.docker.internal:8081}
	}
	handle {
		reverse_proxy {$DAQ_GUI:host.docker.internal:3000}
	}
}
