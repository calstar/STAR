# STAR auth (EC2, standalone) — environment.
#
# Copy to .env on the EC2 box and fill in. NEVER commit .env.
#   cp .env.example .env
#
# This single file is read two ways by docker-compose.yml:
#   - as the auth container's env_file (GOOGLE_*, JWT_SECRET, FLASK_SECRET_KEY…)
#   - for ${CLOUDFLARE_TUNNEL_TOKEN} interpolation in the cloudflared command

# ── Google OAuth ─────────────────────────────────────────────────────────────
# APIs & Services → Credentials → your OAuth 2.0 Client.
# Add this Authorized redirect URI to that client BEFORE first login:
#   https://auth.starberkeley.org/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Shared JWT secret ────────────────────────────────────────────────────────
# Signs the session cookie. Every app that verifies the cookie (the tools on
# the local machine) MUST use this exact value, or every login is rejected.
# Generate ONCE and save it somewhere you can reuse:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# ── Flask session secret ─────────────────────────────────────────────────────
# Used only by auth itself, for OAuth state during the login round-trip.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-another-long-random-string

# ── Public URL of this service ───────────────────────────────────────────────
# Where a browser reaches auth. Used to build the Google callback and the login
# links sent to unauthenticated visitors, so it must be the public URL.
AUTH_PUBLIC_URL=https://auth.starberkeley.org

# ── Cloudflare Tunnel connector token ────────────────────────────────────────
# Zero Trust → Networks → Tunnels → create a tunnel → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# COOKIE_DOMAIN=.starberkeley.org     # cookie scope; BASE_DOMAIN is derived from it
# ALLOWED_EMAIL_DOMAIN=berkeley.edu   # only this domain may log in
# TOKEN_TTL_DAYS=30
