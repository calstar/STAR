{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListThePidBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::star-pid-designer"
    },
    {
      "Sid": "ReadWritePidDiagrams",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::star-pid-designer/*"
    }
  ]
}
