# Build context is the REPO ROOT, not pid-designer/ -- a Dockerfile cannot COPY
# from outside its context, and this image needs auth/shared_auth.py. See the
# pid-designer-api service in docker-compose.yml.
FROM python:3.12-slim
WORKDIR /app

# The backend shells out to git for diagram checkpointing. Present so that the
# feature works when a repo is mounted; without one the module still imports and
# the checkpoint/history endpoints report 503 (see backend/routers/pid.py).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY pid-designer/requirements.txt .
# Retries/timeout: a single slow PyPI read should not fail a deploy build.
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r requirements.txt

# Shared JWT helper, imported by the backend's auth middleware
COPY auth/shared_auth.py /auth/shared_auth.py

COPY pid-designer/backend/ ./backend/

# Diagram autosave target. Mounted as a volume in compose so edits survive a
# rebuild; REPO_ROOT in routers/pid.py resolves to /app.
RUN mkdir -p /app/diagrams

ENV PYTHONPATH=/app:/auth
EXPOSE 8001
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
