# Build context is the REPO ROOT, not pid-designer/: the backend is built on
# lib/stardesign, the design core shared with EngineDesign and
# recovery-calculator. See the pid-designer-api service in docker-compose.yml
# and the .dockerignore that keeps the context from ballooning.
FROM python:3.12-slim
WORKDIR /app

# Env, not CLI flags: pip installs an sdist's build dependencies by spawning a
# fresh subprocess that inherits no command-line options, so --timeout/--retries
# there would silently fall back to the stock 15s. Env vars reach it.
ENV PIP_RETRIES=10 \
    PIP_TIMEOUT=120 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

COPY pid-designer/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

# The shared design core: per-user storage, sharing, and version history. Copied
# before the app so a change to the app alone reuses this layer.
COPY lib/stardesign/ /stardesign/
RUN --mount=type=cache,target=/root/.cache/pip pip install /stardesign

COPY pid-designer/backend/ ./backend/

# Per-user working copies live under USERDATA_DIR (a mounted volume, /data in
# compose); version history lives in S3. Nothing diagram-related is baked in.

ENV PYTHONPATH=/app
EXPOSE 8001
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
