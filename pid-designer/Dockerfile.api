# Build context is the subproject dir: the app implements no auth (Caddy is the
# gate), so nothing from the repo root is needed. See the pid-designer-api
# service in docker-compose.yml.
FROM python:3.12-slim
WORKDIR /app

# The backend shells out to git for diagram checkpointing. Present so that the
# feature works when a repo is mounted; without one the module still imports and
# the checkpoint/history endpoints report 503 (see backend/routers/pid.py).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Env, not CLI flags: pip installs an sdist's build dependencies by spawning a
# fresh subprocess that inherits no command-line options, so --timeout/--retries
# there would silently fall back to the stock 15s. Env vars reach it.
ENV PIP_RETRIES=10 \
    PIP_TIMEOUT=120 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

COPY backend/ ./backend/

# Diagram autosave target. Mounted as a volume in compose so edits survive a
# rebuild; REPO_ROOT in routers/pid.py resolves to /app.
RUN mkdir -p /app/diagrams

ENV PYTHONPATH=/app
EXPOSE 8001
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
