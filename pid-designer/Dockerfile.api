# Build context is the subproject dir: the app implements no auth (Caddy is the
# gate), so nothing from the repo root is needed. See the pid-designer-api
# service in docker-compose.yml.
FROM python:3.12-slim
WORKDIR /app

# Env, not CLI flags: pip installs an sdist's build dependencies by spawning a
# fresh subprocess that inherits no command-line options, so --timeout/--retries
# there would silently fall back to the stock 15s. Env vars reach it.
ENV PIP_RETRIES=10 \
    PIP_TIMEOUT=120 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

COPY backend/ ./backend/

# Per-user working copies live under USERDATA_DIR (a mounted volume, /data in
# compose); version history lives in S3. Nothing diagram-related is baked in.

ENV PYTHONPATH=/app
EXPOSE 8001
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
