[Unit]
Description=Sensor System Elodin DB
After=network.target
# elodin-db must be installed. Without this, a missing binary makes ExecStart fail and
# Restart=always respawn it every 5s — an invisible spin that `systemctl --user --failed`
# never lists. Assert (not Condition) turns it into an immediate, honest unit failure that
# DOES show in --failed and does not retry. Install it: deploy/bootstrap_daq.sh.
AssertPathExists=%h/.cargo/bin/elodin-db

[Service]
Type=simple
# Per-run store: the session-manager writes ELODIN_DB_DIR into session.env before
# starting this unit (see backend service-controller.ts). Falls back to daq_live
# when session control isn't driving it. The `-` makes the file optional.
Environment=ELODIN_DB_DIR=%h/.local/share/elodin/daq_live
EnvironmentFile=-%h/.config/daq/session.env
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/elodin
ExecStart=%h/.cargo/bin/elodin-db run '[::]:2240' '${ELODIN_DB_DIR}'
Restart=always
RestartSec=5
Environment=RUST_LOG=info
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
