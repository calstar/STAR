[Unit]
Description=Sensor System LabJack T7 Bridge (T7 analog inputs → Elodin, inputs only)
After=network.target sensor-elodin.service

[Service]
Type=simple
WorkingDirectory=%h/sensor_system
Environment=DAQ_CONFIG=config/config.toml
EnvironmentFile=-%h/.config/daq/pipeline.env
# $$ is a literal $ for bash (systemd substitutes $VAR itself; ${DAQ_CONFIG} is meant for it).
# A simulated run (USE_SIM=1) streams stand-in T7s, so the GUI shows T7 channels without hardware.
# t7_bridge only ever writes stream/AIN setup registers to the T7s in config: nothing it does
# drives an output.
ExecStart=/bin/bash -c 'if [ -x ./build/bin/t7_bridge ]; then FAKE=""; [ "$${USE_SIM:-0}" = "1" ] && FAKE="--fake"; exec ./build/bin/t7_bridge --config ${DAQ_CONFIG} $$FAKE; else echo "t7_bridge not found — run: cd build && cmake .. && make t7_bridge"; exit 1; fi'
# on-failure, not always: with no enabled T7 in config, t7_bridge exits 0 and should stay down.
# Exit 2 (T7 config errors, listed in the journal) and 3 (built without LJM) will not fix
# themselves by retrying.
Restart=on-failure
RestartPreventExitStatus=2 3
RestartSec=5
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
