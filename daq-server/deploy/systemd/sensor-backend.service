[Unit]
Description=Sensor System Web GUI Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/sensor_system/diablo_server/backend
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=5
# Backend subscribes directly to Elodin DB (127.0.0.1:2240 by default).
Environment=USE_CALIBRATION_SERVICE_CALIBRATED=false
# This is the always-on server: enable run-session control + auto-stop. Laptops
# (start_tmux_dev.sh) leave this unset → the feature stays fully inert.
Environment=SESSION_SERVICE_MODE=systemd
# State transitions → C++ actuator_service (TCP :9998) → UDP to boards
Environment=ACTUATOR_SERVICE_PORT=9998
# Serve the built frontend SPA (frontend/dist) on :3000
Environment=GUI_PORT=3000
# PWM during FIRE → C++ controller_service (reads Elodin, runs RobustDDP, sends UDP PWM)
Environment=USE_CPP_CONTROLLER=true
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
