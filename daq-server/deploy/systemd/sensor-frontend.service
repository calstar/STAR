[Unit]
Description=Sensor System Web GUI Frontend (build static SPA; served by sensor-backend on GUI_PORT)
After=network.target
Before=sensor-backend.service

[Service]
# The frontend is a static Vite build — no server process. This unit just
# (re)builds dist/ at boot if sources changed; sensor-backend serves it on :3000.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/sensor_system
ExecStart=/usr/bin/bash deploy/startup/ensure_frontend_build.sh
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
