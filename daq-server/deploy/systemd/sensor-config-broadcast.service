[Unit]
Description=Sensor System Config Broadcast Service (C++ — ACTUATOR_CONFIG/SENSOR_CONFIG to boards)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/sensor_system
# Config defaults to hardware; the sim overlay points DAQ_CONFIG at the sim config
# via the optional EnvironmentFile (absent on the server ⇒ no change).
Environment=DAQ_CONFIG=config/config.toml
EnvironmentFile=-%h/.config/daq/pipeline.env
ExecStart=/bin/bash -c 'if [ -x ./build/bin/config_broadcast_service ]; then exec ./build/bin/config_broadcast_service --config ${DAQ_CONFIG}; else exec python3 archive/legacy/python-services/config_broadcast_service.py --config ${DAQ_CONFIG}; fi'
Restart=always
RestartSec=5
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
