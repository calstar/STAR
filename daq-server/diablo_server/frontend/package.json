{
  "name": "sensor-system-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:shared": "tsc -p ../shared/tsconfig.json",
    "predev": "npm run build:shared",
    "prebuild": "npm run build:shared",
    "pretest:build": "npm run build:shared",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "axios": "^1.13.5",
    "clsx": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.2.0",
    "uplot": "^1.6.24",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  }
}
