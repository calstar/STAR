// STARProject schema — the flat task-tracker model. No per-project permissions:
// any authenticated user sees and edits everything (filtering, not access
// control, gives "my tasks" later). Blockers are display-only edges.

generator client {
  provider      = "prisma-client-js"
  // native = local dev; debian-openssl-3.0.x = the node:22-bookworm-slim runtime
  // image. Prisma needs the matching query engine for wherever the client runs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  backlog
  todo
  in_progress
  done
  blocked
}

enum TaskPriority {
  low
  medium
  high
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String? // from the auth header; overwritten on every request
  displayName String? // user-chosen override; if set, shown instead of `name`
  createdAt   DateTime @default(now())

  createdProjects         Project[]            @relation("ProjectCreatedBy")
  createdTasks            Task[]               @relation("TaskCreatedBy")
  assignedTasks           Task[]               @relation("TaskAssignee")
  activities              Activity[]           @relation("ActivityActor")
  settings                UserSettings?
  digestSubscriptions     DigestSubscription[]
  emailQueue              EmailQueueItem[]
  payeeProfile            PayeeProfile?
  createdReimbursements   Reimbursement[]      @relation("ReimbursementCreatedBy")
  approvedReimbursements  Reimbursement[]      @relation("ReimbursementApprovedBy")
  reimbursementEvents     ReimbursementEvent[] @relation("ReimbursementEventActor")
  apiTokens               ApiToken[]
  designReParts           TaskManufacturing[]  @relation("ManufacturingDesignRe")
  manufacturingReParts    TaskManufacturing[]  @relation("ManufacturingMfgRe")
  createdBomItems         BomItem[]            @relation("BomItemCreatedBy")
  purchasedBomItems       BomItem[]            @relation("BomItemPurchaser")
  createdPurchaseRequests PurchaseRequest[]    @relation("PurchaseRequestCreatedBy")
  decidedPurchaseRequests PurchaseRequest[]    @relation("PurchaseRequestDecidedBy")
  outreachTouches         OutreachTouch[]      @relation("OutreachTouchActor")
}

// A personal access token for the MCP endpoint (/api/mcp). Only the SHA-256 of
// the token is stored; the plaintext is shown once at creation. `prefix` is the
// first few characters so a user can tell their tokens apart in Settings. A
// revoked token keeps its row (revokedAt set) so the list shows what happened.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  archived    Boolean  @default(false)
  createdById String
  createdBy   User     @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional parent for a subproject. Nests to any depth (LE4 › Engine › Spark
  // igniter); updateProject refuses a move that would make a loop.
  parentId String?
  parent   Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id])
  children Project[] @relation("ProjectHierarchy")

  tasks      Task[]
  digestSubs DigestSubscription[]

  // Program tracking (the homepage's "LE4" card). A featured top-level project
  // shows a segmented phase line for itself and each subproject, by subteam,
  // plus its deadlines.
  // An empty `phases` means the default list in src/lib/program.ts.
  featured      Boolean        @default(false)
  // Homepage card order, lowest first. Subprojects ride on their parent's card.
  trackOrder    Int            @default(0)
  phases        String[]       @default([])
  phaseStatuses SubteamPhase[]
  milestones    Milestone[]

  bomItems         BomItem[]
  purchaseRequests PurchaseRequest[]
}

// A discipline/organizational group, a peer lens to Project. Purely a task tag
// (no membership/roster) — filtering, not access control.
model Subteam {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())

  tasks         Task[]
  digestSubs    DigestSubscription[]
  phaseStatuses SubteamPhase[]
  milestones    Milestone[]
}

// Where one subteam is in a featured project's phase list. `phase` indexes
// Project.phases; phase == phases.length means every phase is done. A row's
// existence is what puts the subteam on that project's homepage card.
model SubteamPhase {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subteamId String
  subteam   Subteam  @relation(fields: [subteamId], references: [id], onDelete: Cascade)
  phase     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([projectId, subteamId])
}

// A dated deadline on a featured project ("CDR", "first cold flow"). With a
// subteam it is that subteam's; without one it is the whole program's.
model Milestone {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subteamId String?
  subteam   Subteam? @relation(fields: [subteamId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  done      Boolean  @default(false)
  // Optional http(s) link the milestone opens (review slides, a test plan).
  url       String?
  createdAt DateTime @default(now())

  @@index([projectId, dueDate])
}

// Per-user preferences (1:1 with User).
model UserSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  theme            String   @default("light") // light | dark
  emailAssignments Boolean  @default(true)
  emailDueSoon     Boolean  @default(true)
  emailOverdue     Boolean  @default(true)
  digestKinds      String[] @default([]) // activity kinds included in the nightly digest
}

// Queued transactional emails (currently task assignments), flushed as ONE email
// per recipient every 15 minutes to conserve SES sends.
model EmailQueueItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // "assigned"
  taskId    String?
  taskTitle String
  projectId String?
  actorName String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([sentAt])
}

// A project/subteam a user follows for their nightly digest.
model DigestSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subteamId String?
  subteam   Subteam? @relation(fields: [subteamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id          String        @id @default(cuid())
  // Global, human-facing task number (#N). Monotonic Postgres sequence: never
  // reused (gaps remain after a delete) and never edited — no update path writes it.
  number      Int           @unique @default(autoincrement())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subteamId   String?
  subteam     Subteam?      @relation(fields: [subteamId], references: [id])
  title       String
  description String?
  blockedNote String? // free-text "why is this blocked" comment (auto-saved, like description)
  status      TaskStatus    @default(backlog)
  priority    TaskPriority?
  assignees   User[]        @relation("TaskAssignee")
  startDate   DateTime?
  dueDate     DateTime?
  boardOrder  Float         @default(0) // ordering within a kanban column (Phase 2)
  archived    Boolean       @default(false) // hidden from active board/lists once done
  // When the task last entered Done; cleared when it leaves. The board keeps a
  // done task in its Done column for DONE_ON_BOARD_DAYS after this, then it is
  // only in the archive (src/lib/board.ts onBoard).
  completedAt DateTime?
  // Points an admin puts on the task (0–1000, null = none). Once the task is
  // done they split evenly between its non-admin assignees on the Leaderboard
  // (src/lib/leaderboard.ts). Only admins may set them (actions/tasks.ts).
  points      Int?
  createdById String
  createdBy   User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  blockedBy     TaskBlocker[]      @relation("BlockedTask") // tasks blocking THIS one
  blocking      TaskBlocker[]      @relation("BlockerTask") // tasks THIS one blocks
  activities    Activity[]
  // Present only for a manufacturing task: the part's details.
  manufacturing TaskManufacturing?
  bomItems      BomItem[]

  @@index([projectId, status])
  @@index([status, completedAt])
}

// The part a manufacturing task makes. A task is a manufacturing task exactly
// when it has this row; every field is optional so it can be filled in as the
// design firms up. Deleted with its task.
model TaskManufacturing {
  taskId     String   @id
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  partName   String?
  onshapeUrl String?
  drawingUrl String?
  quantity   Int?
  material   String?
  // Responsible engineers: who owns the design, and who owns making it.
  designReId String?
  designRe   User?    @relation("ManufacturingDesignRe", fields: [designReId], references: [id], onDelete: SetNull)
  mfgReId    String?
  mfgRe      User?    @relation("ManufacturingMfgRe", fields: [mfgReId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Display-only dependency edges: "task is blocked by blockedByTask". No cascade
// scheduling — used to render a "blocked" badge (Phase 3) and Gantt arrows
// (Phase 4).
model TaskBlocker {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation("BlockedTask", fields: [taskId], references: [id], onDelete: Cascade)
  blockedById   String
  blockedByTask Task     @relation("BlockerTask", fields: [blockedById], references: [id], onDelete: Cascade)
  note          String? // optional reason for the block, shown in the Blocked-by list
  createdAt     DateTime @default(now())

  @@unique([taskId, blockedById])
}

// Idempotency ledger for Phase 5 emails (assignment / due-soon / overdue), so
// the deadline cron never double-sends.
model NotifLog {
  id     String   @id @default(cuid())
  taskId String
  userId String
  kind   String
  sentAt DateTime @default(now())

  @@index([taskId, userId, kind])
}

// Append-only audit log rendered as the Activity feed. Values are stored as the
// human-readable strings at the time of the change (immutable history).
model Activity {
  id        String   @id @default(cuid())
  kind      String // created | deleted | updated | assigned | unassigned | blocker_added | blocker_removed
  field     String? // for kind=updated: status | priority | due | title | subteam
  fromValue String?
  toValue   String? // for kind=assigned/unassigned: the affected person's display name
  taskTitle String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?
  actorId   String
  actor     User     @relation("ActivityActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Runtime-added admins, on top of the built-in seed list in src/lib/admins.ts.
// Email matches the X-Auth-Email identity, stored lowercase.
model AdminEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A seed admin (SEED_ADMIN_EMAILS in src/lib/admins.ts) that an admin removed
// via the UI. Seeds live in code and would otherwise re-appear every request, so
// a tombstone here suppresses one; re-adding the email deletes its tombstone.
model RemovedSeedAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---- Finance: reimbursements filed on CalLink --------------------------------
//
// Two sources share one table: requests filed through STARProject (which an admin
// approves and callink-worker then files on CalLink), and requests that already
// exist on CalLink, imported by the worker's scrape. The CalLink* fields mirror
// CalLink and are written only by the worker API.

enum ReimbursementSource {
  callink // imported from CalLink's history
  starproject // filed through STARProject
}

enum ReimbursementStatus {
  pending_approval // waiting for an admin
  approved // queued for the worker
  submitting // claimed by the worker (leaseUntil), or outcome unknown (needsCheck)
  submitted // on CalLink; its CalLink status is in callinkStatus
  failed // the worker could not file it; an admin can retry
  rejected // an admin declined it (reviewNote says why)
  cancelled // withdrawn before it was filed
}

model Reimbursement {
  id     String              @id @default(cuid())
  // Human-facing number (R-N); also tagged into the CalLink subject as [STAR R-N]
  // so a filing can be found on CalLink again. Never reused, never edited.
  number Int                 @unique @default(autoincrement())
  source ReimbursementSource
  status ReimbursementStatus

  subject               String
  description           String?
  eventDetails          String?
  specialInstructions   String?
  expenditureAction     String   @default("Direct Deposit")
  directDepositSignedUp Boolean?
  category              String? // imported rows only; everything we file is a Reimbursement
  amountCents           Int // sum of the items (ours) or CalLink's submitted amount (imported)

  // Not PII: shown to every member. Emails are stored lowercase.
  payeeFirstName String
  payeeLastName  String
  payeeEmail     String?
  submitterName  String?
  submitterEmail String?
  createdById    String?
  createdBy      User?   @relation("ReimbursementCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ReimbursementApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  reviewNote   String?
  leaseUntil   DateTime? // the worker's claim expires here
  needsCheck   Boolean   @default(false) // the worker may have filed it but could not confirm
  attempts     Int       @default(0)
  lastError    String?

  callinkId            Int?      @unique
  callinkRequestNumber String?
  callinkStatus        String?
  callinkStage         String?
  submittedAmountCents Int?
  approvedAmountCents  Int?
  submittedOn          DateTime?
  callinkDeletedOn     DateTime?
  scrapedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pii    ReimbursementPii?
  items  ReimbursementItem[]
  events ReimbursementEvent[]

  bomItems BomItem[]

  @@index([status])
  @@index([payeeEmail])
  @@index([submitterEmail])
}

// The payee's address, phone and UID. Kept apart so list queries never select
// them; only the payee, the submitter and admins are shown this row.
model ReimbursementPii {
  reimbursementId String        @id
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  street          String
  street2         String?
  city            String
  state           String
  zip             String
  phone           String?
  uid             String?
}

model ReimbursementItem {
  id              String        @id @default(cuid())
  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  position        Int // 1..6, CalLink's item number
  date            String // YYYY-MM-DD for ours; CalLink's free text for imported rows
  vendor          String
  amountCents     Int? // null when an imported total is not money ("N/A")
  amountText      String? // the imported total as typed
  comment         String?
  // Imported rows only; ours are always Supplies / Berkeley, CA / no invoice.
  type            String?
  location        String?
  invoice         String?

  receipts ReceiptFile[]

  @@unique([reimbursementId, position])
}

// A receipt. Ours carry their bytes (ReceiptBlob); imported ones point at the
// document on CalLink.
model ReceiptFile {
  id                String            @id @default(cuid())
  itemId            String
  item              ReimbursementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName          String
  mimeType          String
  size              Int
  callinkDocumentId String?
  callinkHref       String?
  createdAt         DateTime          @default(now())

  blob ReceiptBlob?
}

// Receipt bytes, in their own table so no query that lists receipts loads them.
model ReceiptBlob {
  receiptId String      @id
  receipt   ReceiptFile @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  data      Bytes
}

// What happened to a reimbursement, shown as its timeline.
model ReimbursementEvent {
  id              String        @id @default(cuid())
  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  kind            String // created | approved | rejected | cancelled | retried | claimed | released | submitted | failed | needs_check | callink_status
  fromStatus      String?
  toStatus        String?
  note            String?
  actorId         String?
  actor           User?         @relation("ReimbursementEventActor", fields: [actorId], references: [id])
  actorLabel      String? // "worker" or "scrape" when no member did it
  createdAt       DateTime      @default(now())

  @@index([reimbursementId, createdAt])
}

// A member's saved payee details, used to fill in the reimbursement form.
// `email` is only a default for the form; it never decides who may see what.
model PayeeProfile {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  street                String
  street2               String?
  city                  String
  state                 String
  zip                   String
  phone                 String
  uid                   String
  email                 String?
  directDepositSignedUp Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

// The worker's last report: whether its CalLink session is alive and when it
// last scraped. One row, id "callink".
model WorkerStatus {
  id               String    @id
  session          String // ok | expired
  sessionExpiresAt DateTime? // CalLink logins last a fixed 24 h from sign-in
  lastSeenAt       DateTime
  lastScrapeAt     DateTime?
  note             String?
  // An admin's "Sign in to CalLink" button: requested → running → waiting_duo → ok | failed.
  loginState       String?
  loginRequestedAt DateTime?
  loginRequestedBy String?
  loginUpdatedAt   DateTime?
  loginNote        String?
}

// ---- Bill of materials -------------------------------------------------------
//
// One row per thing to buy, on the project it belongs to (Flight Computer, not
// LE4). A project's BOM tab shows its own lines plus every descendant's, so the
// LE4 page is the whole vehicle without any line being stored twice. Money is
// integer cents, like Finance. The predicted cost is never stored: it is
// computed by src/lib/bom.ts (unit x qty + shipping), one rule for everyone.

enum BomStatus {
  planned // on the list, nobody has signed off on the spend
  approved // an admin said yes
  ordered
  received
}

enum BomKind {
  part // unit cost x quantity + shipping
  allowance // a lump sum with no quantity: "Buffer", "testing and spares"
}

model BomItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind          BomKind @default(part)
  name          String
  partNumber    String? // McMaster 91290A231, a Digikey PN
  // Who makes it, as opposed to who sells it (supplier): STMicroelectronics
  // for a part bought from Digikey.
  manufacturer  String?
  // For an allowance, unitCostCents is the lump sum and quantity is unused.
  unitCostCents Int?
  // Not always a count: "200" feet of shock cord. Up to three decimals.
  quantity      Float?
  shippingCents Int? // estimated shipping, tariffs and tax for the line
  realizedCents Int? // what was actually paid, receipt total
  supplier      String?
  url           String?
  // A backup or spare: counted, but the tab can show totals without them.
  spare         Boolean @default(false)

  status     BomStatus @default(planned)
  approvedAt DateTime?
  orderedAt  DateTime?

  purchaserId   String?
  purchaser     User?   @relation("BomItemPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  // A name typed in (imported sheets say "Steven"), used when nobody is picked.
  purchaserName String?
  location      String? // "Snode", "Kush's house"
  notes         String?

  // The task this line is for (often a manufacturing task), if any.
  taskId              String?
  task                Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // The reimbursement this purchase was filed on. "Reimbursed" is read from
  // it (CalLink says Completed), not ticked by hand.
  reimbursementId     String?
  reimbursement       Reimbursement? @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)
  // Paid back before STARProject tracked reimbursements (imported LE3 rows).
  reimbursedElsewhere Boolean        @default(false)

  requestItems PurchaseRequestItem[]

  position    Float    @default(0) // order within the project, lowest first
  createdById String
  createdBy   User     @relation("BomItemCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([reimbursementId])
}

// ---- PVP: who approves spending ----------------------------------------------
//
// Same shape as the admin list: a seed list in code (src/lib/pvp.ts), runtime
// additions here, and tombstones for removed seeds. Only a PVP may approve a
// purchase request or move a BOM line out of Planned.

model PvpEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model RemovedSeedPvp {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---- Purchase requests --------------------------------------------------------
//
// A member asks for BOM lines to be bought; a PVP approves or rejects the whole
// request. Approving moves its lines to Approved. Each item is a snapshot of
// its line when requested, so the record of what was asked for and approved
// survives later edits or the line being deleted.

enum PurchaseRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model PurchaseRequest {
  id     String                @id @default(cuid())
  // Human-facing PR-N. Never reused, never edited.
  number Int                   @unique @default(autoincrement())
  status PurchaseRequestStatus @default(pending)

  // The project whose BOM it was made from.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note      String?

  createdById String
  createdBy   User     @relation("PurchaseRequestCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  decidedById  String?
  decidedBy    User?     @relation("PurchaseRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  items PurchaseRequestItem[]

  @@index([status, createdAt])
}

model PurchaseRequestItem {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // The live line; null once it is deleted.
  bomItemId String?
  bomItem   BomItem?        @relation(fields: [bomItemId], references: [id], onDelete: SetNull)

  // The line as it was when requested.
  projectId      String
  projectName    String
  kind           BomKind
  name           String
  partNumber     String?
  manufacturer   String?
  unitCostCents  Int?
  quantity       Float?
  shippingCents  Int?
  url            String?
  predictedCents Int
  position       Int
  // The PVP's call on this line: null while the request waits, then true for
  // a line approved and false for one left out of the approval (it stays
  // Planned and can be requested again).
  approved       Boolean?

  @@index([requestId])
  @@index([bomItemId])
}

// ---------------------------------------------------------------------------
// Outreach CRM (/outreach). Admins only: these rows hold donors' emails, home
// addresses and gift amounts, so nothing here is written to the team-wide
// Activity feed. OutreachTouch is the outreach audit trail instead (who did
// what to whom, when). Kinds and stages are plain strings validated against the
// lists in src/lib/outreach/constants.ts, so adding one needs no migration.

// A company, foundation, campus office, school or club we talk to.
model OutreachOrg {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String   @default("company") // ORG_KINDS
  website   String?
  industry  String?
  // How they take a request: "email" (to a contact), "form" (paste into
  // formUrl), "linkedin", "phone". Forms are what fall through the cracks.
  channel   String   @default("email")
  formUrl   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts OutreachContact[]
  deals    OutreachDeal[]
  touches  OutreachTouch[]
}

// One person: a sponsor's rep, a parent, an alumnus, a professor.
model OutreachContact {
  id           String       @id @default(cuid())
  // Normalized (lowercase, trimmed) by src/lib/outreach/emails.ts; null for a
  // person we only know by name or form.
  email        String?      @unique
  altEmails    String[]     @default([])
  firstName    String?
  lastName     String?
  title        String?
  phone        String?
  // Mailing address, for physical perks. Shown only on the contact's page.
  address      String?
  city         String?
  state        String?
  zip          String?
  country      String?
  affiliation  String? // AFFILIATIONS
  tags         String[]     @default([])
  orgId        String?
  org          OutreachOrg? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  doNotContact Boolean      @default(false)
  bounced      Boolean      @default(false)
  source       String? // where the row came from, e.g. "import: ScaleFunder 2025"
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  donations OutreachDonation[]
  touches   OutreachTouch[]

  @@index([orgId])
}

// One sponsorship conversation with one org for one season.
model OutreachDeal {
  id                  String      @id @default(cuid())
  orgId               String
  org                 OutreachOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  season              String // "2026–27"
  type                String      @default("monetary") // DEAL_TYPES
  stage               String      @default("prospect") // DEAL_STAGES
  ask                 String? // what we are asking for, in a sentence
  theirDeliverables   String? // "$3,000", "50% off e-matches"
  valueCents          Int?
  renewal             Boolean     @default(false) // a returning sponsor
  lastContactAt       DateTime?
  nextFollowUpAt      DateTime?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  touches OutreachTouch[]

  @@unique([orgId, season])
  @@index([stage])
  @@index([nextFollowUpAt])
}

// A crowdfunding push, newsletter, event drive.
model OutreachCampaign {
  id            String    @id @default(cuid())
  name          String    @unique
  kind          String    @default("crowdfunding") // CAMPAIGN_KINDS
  url           String?
  goalCents     Int?
  startsAt      DateTime?
  endsAt        DateTime?
  thankYouDueAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  donations OutreachDonation[]
  touches   OutreachTouch[]
}

model OutreachDonation {
  id              String            @id @default(cuid())
  contactId       String
  contact         OutreachContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amountCents     Int
  donatedAt       DateTime
  perkName        String?
  perkStatus      String            @default("none") // none | pending | sent
  // display | hide_amount | hide_name, as the donor chose on the platform.
  displayPref     String?
  // The platform's id for the gift (ScaleFunder sf_id), so the same export
  // imports twice without doubling.
  externalRef     String?           @unique
  createdAt       DateTime          @default(now())

  @@index([campaignId])
  @@index([contactId])
}

// Every interaction: a drafted or sent email, a reply, a form submitted, a call.
model OutreachTouch {
  id         String            @id @default(cuid())
  kind       String // TOUCH_KINDS
  at         DateTime          @default(now())
  contactId  String?
  contact    OutreachContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  orgId      String?
  org        OutreachOrg?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       OutreachDeal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  templateId String?
  template   OutreachTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject    String?
  note       String?
  threadUrl  String?
  actorId    String
  actor      User              @relation("OutreachTouchActor", fields: [actorId], references: [id])

  @@index([at])
  @@index([contactId])
  @@index([orgId])
  @@index([dealId])
}

// A saved segment. `filter` is a SegmentFilter (src/lib/outreach/segments.ts);
// membership is computed when the list is opened, never stored.
model OutreachList {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  filter      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// An email template with {{merge_fields}} (src/lib/outreach/merge.ts).
model OutreachTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String   @default("sponsor_cold") // TEMPLATE_KINDS
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  touches OutreachTouch[]
}
