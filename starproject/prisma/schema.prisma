// STARProject schema — the flat task-tracker model. No per-project permissions:
// any authenticated user sees and edits everything (filtering, not access
// control, gives "my tasks" later). Blockers are display-only edges.

generator client {
  provider = "prisma-client-js"
  // native = local dev; debian-openssl-3.0.x = the node:22-bookworm-slim runtime
  // image. Prisma needs the matching query engine for wherever the client runs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  backlog
  todo
  in_progress
  done
  blocked
}

enum TaskPriority {
  low
  medium
  high
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?  // from the auth header; overwritten on every request
  displayName String? // user-chosen override; if set, shown instead of `name`
  createdAt DateTime @default(now())

  createdProjects Project[] @relation("ProjectCreatedBy")
  createdTasks    Task[]    @relation("TaskCreatedBy")
  assignedTasks   Task[]    @relation("TaskAssignee")
  activities      Activity[] @relation("ActivityActor")
  settings        UserSettings?
  digestSubscriptions DigestSubscription[]
  emailQueue      EmailQueueItem[]
  payeeProfile    PayeeProfile?
  createdReimbursements  Reimbursement[]      @relation("ReimbursementCreatedBy")
  approvedReimbursements Reimbursement[]      @relation("ReimbursementApprovedBy")
  reimbursementEvents    ReimbursementEvent[] @relation("ReimbursementEventActor")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  archived    Boolean  @default(false)
  createdById String
  createdBy   User     @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional parent for a subproject. Enforced to a single level (a subproject
  // can't itself be a parent) in createProject.
  parentId String?
  parent   Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id])
  children Project[] @relation("ProjectHierarchy")

  tasks      Task[]
  digestSubs DigestSubscription[]
}

// A discipline/organizational group, a peer lens to Project. Purely a task tag
// (no membership/roster) — filtering, not access control.
model Subteam {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())

  tasks      Task[]
  digestSubs DigestSubscription[]
}

// Per-user preferences (1:1 with User).
model UserSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  theme            String   @default("light") // light | dark
  emailAssignments Boolean  @default(true)
  emailDueSoon     Boolean  @default(true)
  emailOverdue     Boolean  @default(true)
  digestKinds      String[] @default([]) // activity kinds included in the nightly digest
}

// Queued transactional emails (currently task assignments), flushed as ONE email
// per recipient every 15 minutes to conserve SES sends.
model EmailQueueItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // "assigned"
  taskId    String?
  taskTitle String
  projectId String?
  actorName String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([sentAt])
}

// A project/subteam a user follows for their nightly digest.
model DigestSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subteamId String?
  subteam   Subteam? @relation(fields: [subteamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id          String        @id @default(cuid())
  // Global, human-facing task number (#N). Monotonic Postgres sequence: never
  // reused (gaps remain after a delete) and never edited — no update path writes it.
  number      Int           @unique @default(autoincrement())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subteamId   String?
  subteam     Subteam?      @relation(fields: [subteamId], references: [id])
  title       String
  description String?
  blockedNote String?       // free-text "why is this blocked" comment (auto-saved, like description)
  status      TaskStatus    @default(backlog)
  priority    TaskPriority?
  assignees   User[]        @relation("TaskAssignee")
  startDate   DateTime?
  dueDate     DateTime?
  boardOrder  Float         @default(0) // ordering within a kanban column (Phase 2)
  archived    Boolean       @default(false) // hidden from active board/lists once done
  createdById String
  createdBy   User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  blockedBy TaskBlocker[] @relation("BlockedTask") // tasks blocking THIS one
  blocking  TaskBlocker[] @relation("BlockerTask") // tasks THIS one blocks
  activities Activity[]

  @@index([projectId, status])
}

// Display-only dependency edges: "task is blocked by blockedByTask". No cascade
// scheduling — used to render a "blocked" badge (Phase 3) and Gantt arrows
// (Phase 4).
model TaskBlocker {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation("BlockedTask", fields: [taskId], references: [id], onDelete: Cascade)
  blockedById   String
  blockedByTask Task     @relation("BlockerTask", fields: [blockedById], references: [id], onDelete: Cascade)
  note          String? // optional reason for the block, shown in the Blocked-by list
  createdAt     DateTime @default(now())

  @@unique([taskId, blockedById])
}

// Idempotency ledger for Phase 5 emails (assignment / due-soon / overdue), so
// the deadline cron never double-sends.
model NotifLog {
  id     String   @id @default(cuid())
  taskId String
  userId String
  kind   String
  sentAt DateTime @default(now())

  @@index([taskId, userId, kind])
}

// Append-only audit log rendered as the Activity feed. Values are stored as the
// human-readable strings at the time of the change (immutable history).
model Activity {
  id        String   @id @default(cuid())
  kind      String // created | deleted | updated | assigned | unassigned | blocker_added | blocker_removed
  field     String? // for kind=updated: status | priority | due | title | subteam
  fromValue String?
  toValue   String? // for kind=assigned/unassigned: the affected person's display name
  taskTitle String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?
  actorId   String
  actor     User     @relation("ActivityActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Runtime-added admins, on top of the built-in seed list in src/lib/admins.ts.
// Email matches the X-Auth-Email identity, stored lowercase.
model AdminEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A seed admin (SEED_ADMIN_EMAILS in src/lib/admins.ts) that an admin removed
// via the UI. Seeds live in code and would otherwise re-appear every request, so
// a tombstone here suppresses one; re-adding the email deletes its tombstone.
model RemovedSeedAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---- Finance: reimbursements filed on CalLink --------------------------------
//
// Two sources share one table: requests filed through STARProject (which an admin
// approves and callink-worker then files on CalLink), and requests that already
// exist on CalLink, imported by the worker's scrape. The CalLink* fields mirror
// CalLink and are written only by the worker API.

enum ReimbursementSource {
  callink // imported from CalLink's history
  starproject // filed through STARProject
}

enum ReimbursementStatus {
  pending_approval // waiting for an admin
  approved // queued for the worker
  submitting // claimed by the worker (leaseUntil), or outcome unknown (needsCheck)
  submitted // on CalLink; its CalLink status is in callinkStatus
  failed // the worker could not file it; an admin can retry
  rejected // an admin declined it (reviewNote says why)
  cancelled // withdrawn before it was filed
}

model Reimbursement {
  id     String              @id @default(cuid())
  // Human-facing number (R-N); also tagged into the CalLink subject as [STAR R-N]
  // so a filing can be found on CalLink again. Never reused, never edited.
  number Int                 @unique @default(autoincrement())
  source ReimbursementSource
  status ReimbursementStatus

  subject               String
  description           String?
  eventDetails          String?
  specialInstructions   String?
  expenditureAction     String   @default("Direct Deposit")
  directDepositSignedUp Boolean?
  category              String? // imported rows only; everything we file is a Reimbursement
  amountCents           Int // sum of the items (ours) or CalLink's submitted amount (imported)

  // Not PII: shown to every member. Emails are stored lowercase.
  payeeFirstName String
  payeeLastName  String
  payeeEmail     String?
  submitterName  String?
  submitterEmail String?
  createdById    String?
  createdBy      User?   @relation("ReimbursementCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ReimbursementApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  reviewNote   String?
  leaseUntil   DateTime? // the worker's claim expires here
  needsCheck   Boolean   @default(false) // the worker may have filed it but could not confirm
  attempts     Int       @default(0)
  lastError    String?

  callinkId            Int?      @unique
  callinkRequestNumber String?
  callinkStatus        String?
  callinkStage         String?
  submittedAmountCents Int?
  approvedAmountCents  Int?
  submittedOn          DateTime?
  callinkDeletedOn     DateTime?
  scrapedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pii    ReimbursementPii?
  items  ReimbursementItem[]
  events ReimbursementEvent[]

  @@index([status])
  @@index([payeeEmail])
  @@index([submitterEmail])
}

// The payee's address, phone and UID. Kept apart so list queries never select
// them; only the payee, the submitter and admins are shown this row.
model ReimbursementPii {
  reimbursementId String        @id
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  street          String
  street2         String?
  city            String
  state           String
  zip             String
  phone           String?
  uid             String?
}

model ReimbursementItem {
  id              String        @id @default(cuid())
  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  position        Int // 1..6, CalLink's item number
  date            String // YYYY-MM-DD for ours; CalLink's free text for imported rows
  vendor          String
  amountCents     Int? // null when an imported total is not money ("N/A")
  amountText      String? // the imported total as typed
  comment         String?
  // Imported rows only; ours are always Supplies / Berkeley, CA / no invoice.
  type            String?
  location        String?
  invoice         String?

  receipts ReceiptFile[]

  @@unique([reimbursementId, position])
}

// A receipt. Ours carry their bytes (ReceiptBlob); imported ones point at the
// document on CalLink.
model ReceiptFile {
  id                String            @id @default(cuid())
  itemId            String
  item              ReimbursementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName          String
  mimeType          String
  size              Int
  callinkDocumentId String?
  callinkHref       String?
  createdAt         DateTime          @default(now())

  blob ReceiptBlob?
}

// Receipt bytes, in their own table so no query that lists receipts loads them.
model ReceiptBlob {
  receiptId String      @id
  receipt   ReceiptFile @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  data      Bytes
}

// What happened to a reimbursement, shown as its timeline.
model ReimbursementEvent {
  id              String        @id @default(cuid())
  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  kind            String // created | approved | rejected | cancelled | retried | claimed | released | submitted | failed | needs_check | callink_status
  fromStatus      String?
  toStatus        String?
  note            String?
  actorId         String?
  actor           User?         @relation("ReimbursementEventActor", fields: [actorId], references: [id])
  actorLabel      String? // "worker" or "scrape" when no member did it
  createdAt       DateTime      @default(now())

  @@index([reimbursementId, createdAt])
}

// A member's saved payee details, used to fill in the reimbursement form.
// `email` is only a default for the form; it never decides who may see what.
model PayeeProfile {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  street                String
  street2               String?
  city                  String
  state                 String
  zip                   String
  phone                 String
  uid                   String
  email                 String?
  directDepositSignedUp Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

// The worker's last report: whether its CalLink session is alive and when it
// last scraped. One row, id "callink".
model WorkerStatus {
  id           String    @id
  session      String // ok | expired
  lastSeenAt   DateTime
  lastScrapeAt DateTime?
  note         String?
}
