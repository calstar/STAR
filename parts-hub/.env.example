# ---- Public URL ------------------------------------------------------------
# Where members reach the hub (HTTPS). The Onshape panel lives at $PUBLIC_BASE_URL/panel/
PUBLIC_BASE_URL=https://parts.starberkeley.org

# ---- Onshape OAuth app (Developer Portal > OAuth applications) --------------
# Used by the in-Onshape panel so each member inserts parts as themselves.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
# Must match the redirect URL registered on the OAuth app exactly.
OAUTH_REDIRECT_URL=https://parts.starberkeley.org/panel/oauth/callback
# STAR's Onshape Enterprise (the default).
ONSHAPE_BASE_URL=https://starberkeley.onshape.com

# ---- Service account (owns the STAR Parts Library document) -----------------
# Read + write key pair. In the STAR stack these come from the root .env's
# ONSHAPE_ACCESS_KEY / ONSHAPE_SECRET_KEY, which the hub also accepts.
ONSHAPE_API_ACCESS_KEY=
ONSHAPE_API_SECRET_KEY=
# The 24-character id from the library document's URL: /documents/<id>/w/...
LIBRARY_DOCUMENT_ID=

# ---- Server -----------------------------------------------------------------
# Signs OAuth state and encrypts stored Onshape tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out of the panel (they just sign in again).
SESSION_SECRET=
# Inside Docker this is /data (set in docker-compose.yml).
DATA_DIR=./data
PORT=8080
MAX_UPLOAD_MB=200

# ---- STAR login (hub only; the panel uses Onshape OAuth) --------------------
# header: trust the identity headers STAR's Caddy gate sets from auth's /verify.
# dev:    everyone is DEV_USER_EMAIL. Local development only.
AUTH_MODE=header
AUTH_EMAIL_HEADER=X-Auth-Email
AUTH_NAME_HEADER=X-Auth-User
# Comma-separated; subdomains are allowed too. Leave empty to accept any email the proxy passes.
ALLOWED_EMAIL_DOMAINS=berkeley.edu
DEV_USER_EMAIL=dev@berkeley.edu

# ---- Development ------------------------------------------------------------
# Fake Onshape + seeded sample parts; no credentials needed.
MOCK_ONSHAPE=0
