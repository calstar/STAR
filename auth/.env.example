# ── Google OAuth credentials ───────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Add authorized redirect URIs:
#   https://auth.starberkeley.org/callback   (production)
#   http://localhost:5000/callback            (local testing)

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── JWT / cookie ───────────────────────────────────────────────────────────
# Must be the same value across auth service, EngineDesign, pid-designer, and DAQ server.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET=replace-with-a-long-random-string

# ── Flask internal session secret ─────────────────────────────────────────
# Only needed by the auth service itself for OAuth state handling.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

FLASK_SECRET_KEY=replace-with-another-long-random-string

# ── Optional overrides ─────────────────────────────────────────────────────
# FLASK_ENV=production          # set to "production" on the server (default)
# COOKIE_DOMAIN=.starberkeley.org
# ALLOWED_EMAIL_DOMAIN=berkeley.edu
# TOKEN_TTL_DAYS=30
