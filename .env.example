# Root .env — consumed by docker-compose.
# Copy to .env and fill in values. Never commit .env to git.
#
# Auth secrets (Google OAuth, Flask) live in auth/.env instead — see
# auth/.env.example. JWT_SECRET appears in both and the two must match.

# ── Shared secret ──────────────────────────────────────────────────────────
# Signs and verifies the session cookie. Must be identical to the value in
# auth/.env, or every app will reject every login.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# ── Domain ─────────────────────────────────────────────────────────────────
BASE_DOMAIN=starberkeley.org
AUTH_PUBLIC_URL=https://auth.starberkeley.org

# ── TLS ────────────────────────────────────────────────────────────────────
# https (default) → Caddy obtains Let's Encrypt certificates; needs ports 80
#                   and 443 reachable from the internet.
# http            → Cloudflare terminates TLS and cloudflared reaches Caddy
#                   over plain HTTP. Use with `--profile tunnel`.
SCHEME=https
ACME_EMAIL=infra@starberkeley.org

# Only needed with `--profile tunnel`. From the Cloudflare Zero Trust
# dashboard: Networks → Tunnels → your tunnel → install connector.
# CLOUDFLARE_TUNNEL_TOKEN=

# ── DAQ server ─────────────────────────────────────────────────────────────
# DAQ is not containerised — it runs natively on the test-stand machine because
# it needs the hardware. These tell Caddy where to reach it.
#   host.docker.internal → the machine running this compose stack
#   a hostname/IP        → a separate test-stand box
DAQ_BACKEND=host.docker.internal:8081
DAQ_GUI=host.docker.internal:3000
